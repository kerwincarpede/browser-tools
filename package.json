{
  "name": "browser-tools",
  "private": true,
  "description": "Chrome & Microsoft Edge extensions.",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "package": "npm run package --workspaces",
    "store-assets": "npm run store-assets --workspaces --if-present",
    "versions": "node scripts/versions.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
